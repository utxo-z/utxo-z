@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# What the exported utxoz::utxoz links, so what has to be found before its
# targets file can be used. Boost is headers only: the library links
# Boost::headers and no compiled component, so it asks for none.
find_dependency(Boost)
find_dependency(fmt)

# The spdlog backend links spdlog privately, which for a static library still
# reaches the export, as $<LINK_ONLY:spdlog::spdlog_header_only>. A consumer
# never asks for spdlog, so the package has to.
if("@UTXOZ_LOG_BACKEND@" STREQUAL "spdlog")
    find_dependency(spdlog)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/utxoz-targets.cmake")

check_required_components(utxoz)
