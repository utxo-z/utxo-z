# Directories the test suite creates in the repository root. They are evidence
# while a failure is being read and rubbish afterwards, and one `git add -A`
# after an interrupted run put five hundred of them, with their .dat files and
# their locks, into a commit.
test_*/
build-bench1/
build-bench8/
bench_large_ibd_*/
bench_large_ops_*/
